  "gradient": {
    "$type": "string",
    "arc": {
      "$value": "linear-gradient(90deg, #7930BA 0%, #F99A0E 36%, #E51A6F 68%, #01A2E1 100%)",
      "$description": "The logo's brush arc, left to right."
    },
    "arc-conic": {
      "$value": "conic-gradient(from 200deg at 50% 50%, #7930BA, #F99A0E, #E51A6F, #01A2E1, #7930BA)",
      "$description": "Arc as a ring \u2014 for rotating borders and orbs."
    },
    "lamp": {
      "$value": "radial-gradient(60% 60% at 50% 0%, rgb(255 200 87 / 0.55) 0%, rgb(249 154 14 / 0.18) 35%, transparent 70%)",
      "$description": "Cone of lamp light from the top edge."
    },
    "text-warm": {
