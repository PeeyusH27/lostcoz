# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase — used server-side by the /prebook form action (src/lib/supabase.ts).
# The publishable key is safe in a repo/bundle: `prebookings` is protected by RLS
# and is insert-only for anonymous callers. See supabase/schema.sql.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
